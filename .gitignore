# Data (never commit raw ETT CSVs)
data/
*.csv
*.parquet
!results/runs.csv

# Model checkpoints and heavy run artifacts
*.pt
*.pth
*.ckpt
checkpoints/
results/runs/*/last.pt
results/runs/*/best.pt

# Delivery archives (rebuilt on demand)
deliverables/*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Runtime logs (JSON audit/count files in logs/ ARE tracked)
logs/*.log
logs/tensorboard/

# Temp
*.tmp
*.bak
